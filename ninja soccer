
       <!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🥷 NINJA SOCCER 2D ⚽</title>
    <style>
        * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
        body {
            margin: 0; padding: 0;
            background: linear-gradient(135deg, #0f172a, #1e293b, #0f172a);
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            min-height: 100vh; overflow: hidden;
            touch-action: manipulation;
        }
        h1 {
            margin: 5px 0; color: #38bdf8; font-size: 28px;
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
        }
        #gameContainer {
            background: rgba(30, 41, 59, 0.9);
            padding: 15px; border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.7);
            border: 1px solid rgba(255,255,255,0.15);
            display: flex; flex-direction: column; align-items: center;
            max-width: 100%;
        }
        #ninjaMenu { text-align: center; padding: 20px; }
        .btn {
            display: block; width: 250px; padding: 15px; margin: 15px auto;
            background: #2563eb; color: white; border: none; border-radius: 12px;
            font-size: 18px; font-weight: bold; cursor: pointer; transition: 0.2s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        .btn:hover { background: #1d4ed8; transform: scale(1.05); }
        canvas {
            border: 3px solid rgba(56, 189, 248, 0.4); border-radius: 16px;
            background: #0f172a; display: none;
            max-width: 100%; height: auto;
        }
        .controls-info { margin-top: 15px; color: #94a3b8; font-size: 14px; text-align: center; line-height: 1.6; }
        
        /* Mobil tugmalar uslubi */
        #mobileControls {
            display: none;
            width: 100%;
            max-width: 700px;
            margin-top: 15px;
            justify-content: space-between;
            align-items: center;
            padding: 0 10px;
        }
        .control-group {
            display: flex;
            gap: 10px;
        }
        .touch-btn {
            width: 55px; height: 55px;
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            color: white;
            font-size: 20px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            touch-action: none;
        }
        .touch-btn:active {
            background: rgba(56, 189, 248, 0.6);
            border-color: #38bdf8;
            transform: scale(0.92);
        }
        .action-group .touch-btn {
            background: rgba(234, 179, 8, 0.2);
            border-color: rgba(234, 179, 8, 0.4);
        }
        .action-group .touch-btn:active {
            background: rgba(234, 179, 8, 0.6);
        }
    </style>
</head>
<body>
    <h1>🥷 NINJA SOCCER ⚽</h1>
    <div id="gameContainer">
        <div id="ninjaMenu">
            <h2>O'yin Rejimini Tanlang</h2>
            <button class="btn" onclick="startNinja(1)">1 Kishi (Botga qarshi)</button>
            <button class="btn" style="background: #10b981;" onclick="startNinja(2)">2 Kishilik (Do'st bilan)</button>
            <div class="controls-info">
                <p><b>P1 (Qizil):</b> Yurish: <b>W, A, D</b> | Pass: <b>S</b> | Shot: <b>E</b></p>
                <p><b>P2 (Ko'k):</b> Yurish: <b>I, J, L</b> | Pass: <b>K</b> | Shot: <b>O</b></p>
            </div>
        </div>
        <canvas id="gameCanvas" width="700" height="400"></canvas>
        
        <!-- Telefonlar uchun ekran tugmalari -->
        <div id="mobileControls">
            <!-- Chap tomon: Harakatlanish -->
            <div class="control-group movement-group">
                <button class="touch-btn" id="btnLeft">←</button>
                <button class="touch-btn" id="btnUp">↑</button>
                <button class="touch-btn" id="btnRight">→</button>
            </div>
            <!-- O'ng tomon: To'p tepish -->
            <div class="control-group action-group">
                <button class="touch-btn" id="btnPass" style="font-size: 14px;">PASS</button>
                <button class="touch-btn" id="btnShot" style="font-size: 14px; background: rgba(239, 68, 68, 0.3); border-color: rgba(239, 68, 68, 0.5);">SHOT</button>
            </div>
        </div>
    </div>

    <script>
        let canvas = document.getElementById('gameCanvas');
        let ctx = canvas.getContext("2d");
        let ninjaMenu = document.getElementById('ninjaMenu');
        let mobileControls = document.getElementById('mobileControls');
        let gameMode = 1;
        let score1 = 0, score2 = 0;
        let p1 = { x: 100, y: 280, w: 40, h: 70, vx: 0, vy: 0, color: "#ef4444" };
        let p2 = { x: 560, y: 280, w: 40, h: 70, vx: 0, vy: 0, color: "#3b82f6" };
        let ball = { x: 350, y: 150, r: 14, vx: 0, vy: 0, color: "#facc15" };
        let keys = {};
        let gameRunning = false;

        // Klaviaturani eshitish
        window.addEventListener("keydown", e => { keys[e.code] = true; keys[e.key.toLowerCase()] = true; });
        window.addEventListener("keyup", e => { keys[e.code] = false; keys[e.key.toLowerCase()] = false; });

        // Mobil tugmalar funksionalligi (Touch hodisalari)
        function setupMobileButton(elementId, keyCode) {
            const btn = document.getElementById(elementId);
            btn.addEventListener("touchstart", (e) => { e.preventDefault(); keys[keyCode] = true; });
            btn.addEventListener("touchend", (e) => { e.preventDefault(); keys[keyCode] = false; });
        }

        setupMobileButton("btnLeft", "a");
        setupMobileButton("btnRight", "d");
        setupMobileButton("btnUp", "w");
        setupMobileButton("btnPass", "s");
        setupMobileButton("btnShot", "e");

        function startNinja(mode) {
            gameMode = mode;
            ninjaMenu.style.display = 'none';
            canvas.style.display = 'block';
            
            // Sensorli qurilmalarda tugmalarni ko'rsatish
            if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
                mobileControls.style.display = 'flex';
            }
            
            score1 = 0; score2 = 0;
            resetPositions();
            gameRunning = true;
            loop();
        }

        function resetPositions() {
            p1.x = 100; p1.y = 280; p1.vx = 0; p1.vy = 0;
            p2.x = 560; p2.y = 280; p2.vx = 0; p2.vy = 0;
            ball.x = 350; ball.y = 100; ball.vx = 0; ball.vy = 0;
        }

        function update() {
            if (!gameRunning) return;

            // P1 Boshqaruvi (W, A, D) - Klaviaturada ham, telefonda ham ishlaydi
            if (keys["KeyA"] || keys["a"]) p1.vx = -4.5;
            else if (keys["KeyD"] || keys["d"]) p1.vx = 4.5;
            else p1.vx = 0;
            if ((keys["KeyW"] || keys["w"]) && p1.y >= 280) p1.vy = -12;

            // P2 Boshqaruvi (I, J, L)
            if (gameMode === 2) {
                if (keys["KeyJ"] || keys["j"]) p2.vx = -4.5;
                else if (keys["KeyL"] || keys["l"]) p2.vx = 4.5;
                else p2.vx = 0;
                if ((keys["KeyI"] || keys["i"]) && p2.y >= 280) p2.vy = -12;
            } else {
                if (ball.x > p2.x + 15) p2.vx = 3.2;
                else if (ball.x < p2.x - 15) p2.vx = -3.2;
                else p2.vx = 0;
                if (ball.y < p2.y && p2.y >= 280 && Math.random() < 0.03) p2.vy = -11;
            }

            [p1, p2].forEach(p => {
                p.vy += 0.55; p.y += p.vy; p.x += p.vx;
                if (p.y > 280) { p.y = 280; p.vy = 0; }
                if (p.x < 0) p.x = 0; if (p.x > 660) p.x = 660;
            });

            if (p1.x > 310) p1.x = 310;
            if (p2.x < 350) p2.x = 350;

            // P1 PASS (S) va SHOT (E)
            let p1Dist = Math.hypot(ball.x - (p1.x + p1.w/2), ball.y - (p1.y + p1.h/2));
            if (p1Dist < 45) {
                if (keys["KeyS"] || keys["s"]) { ball.vx = 7; ball.vy = -4; }
                if (keys["KeyE"] || keys["e"]) { ball.vx = 14; ball.vy = -8; }
            }

            // P2 PASS (K) va SHOT (O)
            let p2Dist = Math.hypot(ball.x - (p2.x + p2.w/2), ball.y - (p2.y + p2.h/2));
            if (p2Dist < 45) {
                if (keys["KeyK"] || keys["k"]) { ball.vx = -7; ball.vy = -4; }
                if (keys["KeyO"] || keys["o"]) { ball.vx = -14; ball.vy = -8; }
            }

            ball.vy += 0.4; ball.x += ball.vx; ball.y += ball.vy;

            if (ball.x - ball.r < 0) { ball.x = ball.r; ball.vx *= -0.8; }
            if (ball.x + ball.r > 700) { ball.x = 700 - ball.r; ball.vx *= -0.8; }
            if (ball.y - ball.r < 0) { ball.y = ball.r; ball.vy *= -0.8; }
            if (ball.y + ball.r > 350) {
                ball.y = 350 - ball.r; ball.vy *= -0.7; ball.vx *= 0.95;
            }

            if (ball.x - ball.r < 50 && ball.y > 210) { score2++; resetPositions(); }
            if (ball.x + ball.r > 650 && ball.y > 210) { score1++; resetPositions(); }

            [p1, p2].forEach(p => {
                let cx = Math.max(p.x, Math.min(ball.x, p.x + p.w));
                let cy = Math.max(p.y, Math.min(ball.y, p.y + p.h));
                let dx = ball.x - cx, dy = ball.y - cy;
                if (Math.sqrt(dx*dx + dy*dy) < ball.r) {
                    ball.vx = (ball.x - (p.x + p.w/2)) * 0.2 + p.vx * 0.4;
                    ball.vy = (ball.y - (p.y + p.h/2)) * 0.2 + p.vy * 0.4;
                }
            });
        }

